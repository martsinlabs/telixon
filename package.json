{
  "name": "telixon",
  "version": "0.0.0",
  "private": true,
  "description": "Phone-number library for JavaScript and TypeScript.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "Myroslav Martsin <myroslav@martsinlabs.com>",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "bench": "vitest bench --run",
    "bench:report": "vitest bench --run --outputJson=packages/core/bench/dist/bench-raw.json && tsx packages/core/bench/measure-keystroke-latency.ts && tsx packages/core/bench/emit-artifacts.ts packages/core/bench/dist/bench-raw.json",
    "bench:watch": "vitest bench",
    "build": "pnpm --filter \"./packages/*\" run build",
    "conformance": "vitest run --config vitest.conformance.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fuzz": "vitest run --config vitest.fuzz.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "size": "size-limit",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:conformance": "tsc --noEmit -p packages/core/conformance/tsconfig.json"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.7.1",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^12.1.0",
    "@types/node": "^26.6.2",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "flag-icons": "7.5.0",
    "happy-dom": "^20.14.5",
    "miniflare": "4.20260730.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "sharp": "0.35.4",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.16.1",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "undici": "^7.29.0",
      "yaml": "^2.8.3"
    }
  }
}
