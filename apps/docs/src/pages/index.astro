    <!-- Live hero demo: the real packages, imported from the workspace. -->
    <script>
      import { ensureEngineReady } from '@telixon/core';
      import { createPhoneInput, regionToFlagEmoji } from '@telixon/web-sdk';

      const input = document.getElementById('hero-input') as HTMLInputElement | null;
      const shell = document.getElementById('hero-shell');
      const flag = document.getElementById('hero-flag');
      const region = document.getElementById('hero-region');
      const type = document.getElementById('hero-type');
      const e164 = document.getElementById('hero-e164');
      const pill = document.getElementById('hero-valid');
      const errorEl = document.getElementById('hero-error');
      const errorKindEl = document.getElementById('hero-error-kind');
      const errorNoteEl = document.getElementById('hero-error-note');

      if (input && shell && flag && region && type && e164 && pill && errorEl && errorKindEl && errorNoteEl) {
        ensureEngineReady()
          .then(() => {
            const phoneInput = createPhoneInput({
              mode: 'international',
              input,
              display: { callingCodeInInput: true, plusPrefix: 'erasable' },
            });

            type HeroValidationError = NonNullable<ReturnType<typeof phoneInput.getState>['validationError']>;

            const describeError = (error: HeroValidationError): string => {
              switch (error.kind) {
                case 'TOO_SHORT':
                  return 'min ' + error.minLength + ' digits';
                case 'TOO_LONG':
                  return 'max ' + error.maxLength + ' digits';
                case 'INVALID_LENGTH':
                  return 'expected ' + error.possibleLengths.join(' or ') + ' digits';
                case 'NATIONAL_PREFIX_MISSING':
                  return 'expected prefix ' + error.expectedPrefix;
                default:
                  return '';
              }
            };

            const render = (): void => {
              const state = phoneInput.getState();
              const number = phoneInput.getPhoneNumber();
              const valid = number.isValid();

              const numberType = valid ? number.getNumberType() : null;
              const e164Value = number.formatE164();

              flag.textContent = state.region ? regionToFlagEmoji(state.region) : '🌐';
              region.textContent = state.region ?? '';
              region.classList.toggle('empty', !state.region);
              type.textContent = numberType ?? '';
              type.classList.toggle('empty', !numberType);
              e164.textContent = e164Value ?? '';
              e164.classList.toggle('empty', !e164Value);

              const error = state.validationError;
              const activeError = error && error.kind !== 'EMPTY' ? error : null;
              errorKindEl.textContent = activeError ? activeError.kind : '';
              errorNoteEl.textContent = activeError ? describeError(activeError) : '';
              errorEl.classList.toggle('empty', !activeError);
              errorEl.classList.toggle('has-error', !!activeError);
              pill.classList.toggle('on', valid);
              shell.classList.toggle('valid', valid);
              input.placeholder = state.placeholder ?? '+1 415-555-0132';
            };

            phoneInput.subscribe(render);
            render();
            input.readOnly = false;

            phoneInput.setValue('+14155550132');
            phoneInput.clearHistory();
          })
          .catch(() => {
            // Engine failed to load; the field keeps its seeded value read-only.
          });
      }

      // Live AR demo in the Input Controller section: strict national, region pinned to AR.
      const arInput = document.getElementById('ar-input') as HTMLInputElement | null;
      const arE164 = document.getElementById('ar-e164');

      if (arInput && arE164) {
        ensureEngineReady()
          .then(() => {
            const arPhoneInput = createPhoneInput({
              mode: 'national',
              defaultRegion: 'AR',
              strict: true,
              input: arInput,
              initialValue: '0111523456789',
            });

            const renderAr = (): void => {
              const state = arPhoneInput.getState();
              const e164Value = arPhoneInput.getPhoneNumber().formatE164();

              arE164.textContent = e164Value ?? '';
              arE164.classList.toggle('empty', !e164Value);
              arInput.placeholder = state.placeholder ?? '';
            };

            arPhoneInput.subscribe(renderAr);
            renderAr();
            arInput.readOnly = false;
          })
          .catch(() => {
            // Engine failed to load; the field keeps its seeded value read-only.
          });
      }
    </script>

    <script is:inline>
      // Theme toggle, persisted under Starlight's key so the docs pages follow.
      var themeToggle = document.getElementById('theme-toggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('starlight-theme', next);
          } catch (e) {
            /* storage unavailable */
          }
        });
      }

      // Nav background on scroll.
      var nav = document.getElementById('nav');
      var onScroll = function () {
        nav.classList.toggle('scrolled', window.scrollY > 12);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // The atmosphere rides up with the page; overscroll never drags it down (scrollY clamps at 0).
      (function () {
        var atmosphere = document.querySelector('.atmosphere');
        if (!atmosphere) return;
        var ticking = false;
        function sync() {
          atmosphere.style.transform = 'translateY(' + -Math.max(window.scrollY, 0) + 'px)';
          ticking = false;
        }
        window.addEventListener(
          'scroll',
          function () {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(sync);
          },
          { passive: true },
        );
        sync();
      })();

      // Reveal sections on scroll.
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach(function (el) {
        observer.observe(el);
      });

      // Compiled Engine walk: digits type above while landing along a path through the state map.
      (function () {
        var grid = document.getElementById('dfa-grid');
        var digitsEl = document.getElementById('walk-digits');
        var result = document.getElementById('walk-result');
        if (!grid || !digitsEl || !result) return;

        var CELL_COUNT = 48;
        for (var i = 0; i < CELL_COUNT; i++) {
          var cell = document.createElement('span');
          cell.className = 'dcell';
          grid.appendChild(cell);
        }
        var cells = grid.children;
        var PATH = [12, 13, 1, 2, 3, 15, 27, 28, 29, 17, 18];
        var LINE = ['+1', ' 4', '1', '5', ' 5', '5', '5', ' 0', '1', '3', '2'];

        function fillStep(step, final) {
          cells[PATH[step]].classList.add(final ? 'on' : 'trail');
        }

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          for (var k = 0; k < PATH.length; k++) fillStep(k, k === PATH.length - 1);
          digitsEl.textContent = '+1 415 555 0132';
          result.classList.add('show');
          return;
        }

        function reset() {
          digitsEl.textContent = '';
          result.classList.remove('show');
          for (var j = 0; j < cells.length; j++) cells[j].className = 'dcell';
        }

        function walk(step) {
          if (step >= PATH.length) {
            result.classList.add('show');
            setTimeout(loop, 3000);
            return;
          }
          if (step > 0) {
            cells[PATH[step - 1]].classList.remove('on');
            cells[PATH[step - 1]].classList.add('hot');
          }
          if (step > 1) {
            cells[PATH[step - 2]].classList.remove('hot');
            cells[PATH[step - 2]].classList.add('trail');
          }
          fillStep(step, true);
          digitsEl.textContent += LINE[step];
          setTimeout(function () {
            walk(step + 1);
          }, 200);
        }

        function loop() {
          reset();
          setTimeout(function () {
            walk(0);
          }, 800);
        }

        loop();
      })();
    </script>
  </body>
</html>
