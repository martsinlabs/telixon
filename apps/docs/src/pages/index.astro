---
// Telixon landing page. Custom design outside the Starlight chrome; docs live under /core/ and /web-sdk/.
// Section order follows the claim-then-proof funnel: hero, verified, engine, input controller, DX, packages, get started.
// Code blocks render through Expressive Code; the site-wide palette lives in ec.config.mjs.
import { Code } from '@astrojs/starlight/components';
import logoDark from '../assets/logo-dark.svg';
import logoLight from '../assets/logo-light.svg';

const quickstartCode = `import { ensureEngineReady, parsePhoneNumber } from '@telixon/core';

await ensureEngineReady();

const number = parsePhoneNumber('+1 (415) 555-0132');

number.isValid();        // true
number.getRegion();      // 'US'
number.getNumberType();  // 'FIXED_LINE_OR_MOBILE'
number.formatE164();     // '+14155550132'`;

const coreControllerCode = `import {
  createNationalInputController,
} from '@telixon/core';

const controller = createNationalInputController({
  defaultRegion: 'AR',
});

controller.insert('011 15-2345-678', '9', 15, 15);
// '011 15-2345-6789', caret 16

controller.deleteBackward('011 15-2345-6789', 16, 16);
// '011 15-2345-678', caret 15

controller.undo(); // '011 15-2345-6789'
controller.redo(); // '011 15-2345-678'`;

const webSdkCode = `import {
  createPhoneInput,
} from '@telixon/web-sdk';

const phoneInput = createPhoneInput({
  mode: 'national',
  input: document.querySelector('input')!,
  defaultRegion: 'AR',
});

phoneInput.subscribe(({ validationError }) => {
  hint.textContent = validationError?.kind ?? '';
});

phoneInput.getPhoneNumber().formatE164();
// '+5491123456789' for the value above`;

const validationErrorCode = `partial.getValidationError()
// { kind: 'TOO_SHORT', minLength: 10 }`;

const closedTypesCode = `controller.setRegion('USA')
// compile error: not assignable to RegionCode`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Parsing, validation, formatting, and a headless input controller. Verified against Google libphonenumber."
    />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>Telixon, phone number toolkit for JavaScript and TypeScript</title>
    <link rel="canonical" href="https://docs.telixon.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://docs.telixon.dev/" />
    <meta property="og:title" content="Telixon, phone number toolkit for JavaScript and TypeScript" />
    <meta
      property="og:description"
      content="Parsing, validation, formatting, and a headless input controller. Verified against Google libphonenumber."
    />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161618" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f8f8" />
    <script is:inline>
      // Resolve the theme before first paint; shares Starlight's storage key so the docs match.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch (e) {
          /* storage unavailable */
        }
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <style is:inline>
      :root {
        --bg: #161618;
        --panel: rgba(255, 255, 255, 0.025);
        --panel-2: rgba(255, 255, 255, 0.045);
        --border: rgba(255, 255, 255, 0.08);
        --border-strong: rgba(255, 255, 255, 0.16);
        --text: #f2f3f4;
        --muted: #9ba1a6;
        --faint: #666b71;
        --green: #26997b;
        --green-bright: #1fd8a4;
        --green-glow: rgba(38, 153, 123, 0.35);
        --green-dim: rgba(38, 153, 123, 0.12);
        --radius: 14px;
        --container: 1120px;
        --font-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;

        --card-shadow: 0 30px 80px -35px rgba(0, 0, 0, 0.8);
        --field-bg: rgba(0, 0, 0, 0.45);
        --nav-bg: rgba(22, 22, 24, 0.78);
        --grid-dot: rgba(255, 255, 255, 0.05);
        --link-underline: rgba(31, 216, 164, 0.35);
        --error: #e5484d;
        --cta-bg: #058e69;
        --cta-bg-hover: #07a077;
        --surface: #212225;
        --surface-border: rgba(255, 255, 255, 0.08);
        --surface-shadow: 0 8px 20px -14px rgba(0, 0, 0, 0.5), 0 1px 4px -2px rgba(0, 0, 0, 0.3);
      }

      [data-theme='light'] {
        --bg: #f7f8f8;
        --panel: rgba(0, 0, 0, 0.035);
        --panel-2: rgba(0, 0, 0, 0.06);
        --border: rgba(0, 0, 0, 0.09);
        --border-strong: rgba(0, 0, 0, 0.18);
        --text: #17191b;
        --muted: #4c5257;
        --faint: #7d838a;
        --green: #26997b;
        --green-bright: #208368;
        --green-glow: rgba(38, 153, 123, 0.28);
        --green-dim: rgba(38, 153, 123, 0.12);
        --card-shadow: 0 24px 60px -32px rgba(20, 45, 32, 0.2);
        --field-bg: #ffffff;
        --nav-bg: rgba(247, 248, 248, 0.85);
        --grid-dot: rgba(0, 0, 0, 0.06);
        --link-underline: rgba(32, 131, 104, 0.35);
        --error: #ce2c31;
        --cta-bg: var(--green);
        --cta-bg-hover: color-mix(in srgb, var(--green) 86%, #0b1f15);
        --surface: #ffffff;
        --surface-border: rgba(0, 0, 0, 0.1);
        --surface-shadow: 0 10px 22px -14px rgba(20, 45, 32, 0.2), 0 2px 5px -3px rgba(20, 45, 32, 0.1);
      }

      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 84px;
      }

      body {
        margin: 0;
        background: var(--bg);
        transition:
          background 0.25s ease,
          color 0.25s ease;
        color: var(--text);
        font-family: var(--font-sans);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      /* Fixed layer moved up by scroll position via transform: it rides up with the page but can never travel below its rest position (overscroll clamps at zero). */
      .atmosphere {
        position: fixed;
        inset: 0 0 auto 0;
        height: 980px;
        pointer-events: none;
        will-change: transform;
        background:
          radial-gradient(720px 520px at 50% -80px, rgba(38, 153, 123, 0.16), transparent),
          radial-gradient(1200px 760px at 50% -200px, rgba(38, 153, 123, 0.07), transparent);
        /* The whole layer dissolves long before its own edge, so scrolling never reveals a seam. */
        -webkit-mask-image: linear-gradient(180deg, #000 45%, rgba(0, 0, 0, 0.45) 70%, transparent 92%);
        mask-image: linear-gradient(180deg, #000 45%, rgba(0, 0, 0, 0.45) 70%, transparent 92%);
      }
      .atmosphere::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
        background-size: 26px 26px;
        mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.5), transparent 80%);
      }

      a {
        color: inherit;
        text-decoration: none;
      }
      /* Grid children default to min-width auto; code blocks would otherwise inflate their tracks past the viewport. */
      .hero-grid > *,
      .verified-grid > *,
      .engine-grid > *,
      .io-grid > *,
      .start-grid > *,
      .paths > .path,
      .bento > .cell {
        min-width: 0;
      }
      .container {
        width: 100%;
        max-width: var(--container);
        margin: 0 auto;
        padding: 0 28px;
        position: relative;
      }

      ::selection {
        background: rgba(38, 153, 123, 0.35);
      }

      /* ---------- Nav ---------- */
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 40;
        transition:
          background 0.25s ease,
          border-color 0.25s ease;
        border-bottom: 1px solid transparent;
      }
      .nav.scrolled {
        background: var(--nav-bg);
        backdrop-filter: saturate(150%) blur(14px);
        border-bottom-color: var(--border);
      }
      .nav .container {
        display: flex;
        align-items: center;
        gap: 30px;
        height: 68px;
      }
      .brand {
        display: flex;
        align-items: center;
      }
      .brand-logo {
        height: 24px;
        display: block;
      }
      .brand-logo-light {
        display: none;
      }
      [data-theme='light'] .brand-logo-dark {
        display: none;
      }
      [data-theme='light'] .brand-logo-light {
        display: block;
      }
      .brand .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: var(--green);
        box-shadow:
          0 0 14px var(--green-glow),
          0 0 3px var(--green);
      }
      .nav-links {
        display: flex;
        gap: 26px;
        margin-left: 12px;
        color: var(--muted);
        font-size: 14.5px;
        font-weight: 500;
      }
      .nav-links a {
        transition: color 0.15s ease;
      }
      .nav-links a:hover {
        color: var(--text);
      }
      .nav-right {
        margin-left: auto;
        display: flex;
        gap: 10px;
        align-items: center;
      }
      .nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 13.5px;
        font-weight: 600;
        padding: 8px 14px;
        border-radius: 9px;
        border: 1px solid var(--border-strong);
        color: var(--text);
        transition:
          border-color 0.15s ease,
          background 0.15s ease;
      }
      .nav-btn:hover {
        border-color: var(--green);
        background: var(--green-dim);
      }
      .nav-btn svg {
        width: 15px;
        height: 15px;
        fill: currentColor;
      }
      .nav-cta {
        border: none;
        background: var(--cta-bg);
        color: #ffffff;
        box-shadow: 0 1px 2px rgba(11, 40, 26, 0.16);
      }
      .nav-cta:hover {
        background: var(--cta-bg-hover);
        color: #ffffff;
      }

      .theme-toggle {
        padding: 8px 10px;
        cursor: pointer;
        background: none;
        border: none;
      }
      .theme-toggle svg {
        width: 16px;
        height: 16px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
      }
      .theme-toggle .icon-moon {
        display: none;
      }
      [data-theme='light'] .theme-toggle .icon-sun {
        display: none;
      }
      [data-theme='light'] .theme-toggle .icon-moon {
        display: block;
      }

      /* ---------- Hero ---------- */
      .hero {
        position: relative;
        padding: 168px 0 96px;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1.18fr 0.82fr;
        gap: 56px;
        align-items: center;
      }
      .hero h1 {
        font-size: clamp(28px, 3.4vw, 44px);
        line-height: 1.12;
        letter-spacing: -0.025em;
        font-weight: 750;
        margin: 0 0 20px;
        text-wrap: balance;
      }
      .hero h1 .hl {
        background: linear-gradient(100deg, var(--green-bright), var(--green) 80%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .hero .sub {
        font-size: 18px;
        color: var(--muted);
        max-width: 480px;
        margin: 0 0 18px;
        text-wrap: balance;
      }
      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        margin-bottom: 26px;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 13px 22px;
        border-radius: 11px;
        font-size: 15px;
        font-weight: 650;
        letter-spacing: -0.01em;
        border: 1px solid transparent;
        transition:
          transform 0.15s ease,
          box-shadow 0.15s ease,
          border-color 0.15s ease,
          background 0.15s ease;
      }
      .btn svg {
        width: 15px;
        height: 15px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.2;
      }
      .btn-primary {
        background: var(--cta-bg);
        color: #ffffff;
        box-shadow: 0 1px 2px rgba(11, 40, 26, 0.16);
      }
      .btn-primary:hover {
        background: var(--cta-bg-hover);
      }
      .btn-ghost {
        border-color: var(--border-strong);
        color: var(--text);
      }
      .btn-ghost:hover {
        border-color: var(--green);
        color: var(--green-bright);
      }

      .hero-proof {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 9px;
        margin: 0 0 34px;
        font-size: 13.5px;
        color: var(--muted);
      }

      /* Hero live demo card: one solid surface, defined by light instead of edges */
      .demo-card {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--surface-border);
        border-radius: 20px;
        padding: 28px;
        box-shadow: var(--surface-shadow);
      }
      .demo-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
      }
      .demo-title {
        font-family: var(--font-mono);
        font-size: 11.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--faint);
      }
      .valid-pill {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--green-bright);
        border: 1px solid rgba(38, 153, 123, 0.45);
        background: var(--green-dim);
        border-radius: 999px;
        padding: 3px 10px;
        opacity: 0;
        transition: opacity 0.35s ease;
      }
      .valid-pill.on {
        opacity: 1;
      }
      .demo-input {
        display: flex;
        align-items: center;
        background: var(--field-bg);
        border: 1px solid var(--border-strong);
        border-radius: 12px;
        padding: 0 14px;
        width: 100%;
        height: 52px;
        transition:
          border-color 0.3s ease,
          box-shadow 0.3s ease;
      }
      .demo-input:focus-within {
        border-color: var(--border-strong);
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06);
      }
      .demo-input.valid {
        border-color: rgba(38, 153, 123, 0.55);
        box-shadow: 0 0 0 3px rgba(38, 153, 123, 0.12);
      }
      .demo-input .flag {
        margin-right: 12px;
        font-size: 20px;
        line-height: 1;
      }
      .demo-input input {
        flex: 1;
        background: none;
        border: none;
        outline: none;
        color: var(--text);
        font-family: var(--font-mono);
        font-size: 17px;
        padding: 15px 0;
        min-width: 0;
        caret-color: var(--green-bright);
      }
      .demo-input input::placeholder {
        color: var(--faint);
        opacity: 1;
      }
      .demo-rows {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: repeat(4, 26px);
        align-items: center;
        gap: 4px 22px;
        margin-top: 18px;
        font-size: 13.5px;
      }
      .demo-rows .k {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faint);
        align-self: center;
      }
      .demo-rows .v {
        font-family: var(--font-mono);
        color: var(--text);
        text-align: right;
        white-space: nowrap;
        overflow: hidden;
      }
      .demo-rows .v.empty {
        color: var(--faint);
      }
      /* Empty readout slot: a quiet bar instead of a character. */
      .demo-rows .v.empty::after,
      .field-readout code.empty::after {
        content: '';
        display: inline-block;
        width: 16px;
        height: 3px;
        border-radius: 2px;
        background: var(--border-strong);
        vertical-align: middle;
      }
      .demo-rows .v.has-error {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
      }
      .err-kind {
        color: var(--error);
        font-weight: 600;
      }
      .demo-rows .v.accent {
        color: var(--green-bright);
      }

      /* ---------- Sections ---------- */
      section {
        position: relative;
        padding: 104px 0;
      }
      .sec-head {
        margin-bottom: 14px;
      }
      h2 {
        font-size: clamp(30px, 4vw, 44px);
        line-height: 1.08;
        letter-spacing: -0.03em;
        font-weight: 750;
        margin: 0;
      }
      .lead {
        color: var(--muted);
        max-width: 660px;
        font-size: 17px;
        margin: 18px 0 0;
      }
      .lead code,
      .prose code {
        color: var(--green-bright);
        font-family: var(--font-mono);
        font-size: 0.88em;
      }
      .hairline {
        height: 1px;
        background: var(--border);
      }

      /* ---------- Verified ---------- */
      .verified-grid {
        display: grid;
        grid-template-columns: 1fr 0.85fr;
        gap: 64px;
        align-items: center;
        margin-top: 44px;
      }
      .prose p {
        color: var(--muted);
        font-size: 16px;
        margin: 0 0 18px;
      }
      .prose p:last-child {
        margin-bottom: 0;
      }
      .link-green {
        color: var(--green-bright);
        border-bottom: 1px solid var(--link-underline);
        transition: border-color 0.15s ease;
      }
      .link-green:hover {
        border-bottom-color: var(--green-bright);
      }
      .proof-card {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--surface-border);
        box-shadow: var(--surface-shadow);
        border-radius: 18px;
        padding: 32px 30px;
        box-shadow:
          var(--card-shadow),
          0 0 70px -40px var(--green-glow);
      }
      .proof-big {
        font-size: 72px;
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1;
        background: linear-gradient(100deg, var(--green-bright), var(--green));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        font-feature-settings: 'tnum';
      }
      .proof-sub {
        color: var(--muted);
        font-size: 14px;
        margin: 10px 0 24px;
      }
      .proof-rows {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 12px 24px;
        font-size: 13.5px;
        border-top: 1px solid var(--border);
        padding-top: 20px;
      }
      .proof-rows .k {
        color: var(--muted);
      }
      .proof-rows .v {
        font-family: var(--font-mono);
        color: var(--text);
        text-align: right;
        font-feature-settings: 'tnum';
      }
      .proof-rows .v a {
        border-bottom: 1px solid var(--link-underline);
        color: var(--green-bright);
      }
      .footnote {
        color: var(--faint);
        font-size: 13px;
        max-width: 640px;
        margin: 26px 0 0;
      }

      /* ---------- Engine ---------- */
      .engine-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 64px;
        align-items: center;
        margin-top: 44px;
      }
      .dfa {
        background: var(--surface);
        border: 1px solid var(--surface-border);
        box-shadow: var(--surface-shadow);
        border-radius: 18px;
        padding: 34px 30px;
      }
      .dfa-label {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--faint);
        margin: 0 0 18px;
      }
      .walk-digits {
        font-family: var(--font-mono);
        font-size: 17px;
        color: var(--text);
        letter-spacing: 1px;
        min-height: 1.5em;
        margin: 0 0 16px;
      }
      .dfa-grid {
        display: grid;
        grid-template-columns: repeat(12, 17px);
        gap: 5px;
        margin: 0 0 20px;
      }
      .dcell {
        width: 17px;
        height: 17px;
        border-radius: 4px;
        background: var(--panel);
        border: 1px solid var(--border);
        transition:
          background 0.3s ease,
          border-color 0.3s ease;
        animation: cellidle 5.2s ease-in-out infinite;
      }
      .dcell:nth-child(3n) {
        animation-delay: 1.1s;
      }
      .dcell:nth-child(4n) {
        animation-delay: 2.3s;
      }
      .dcell:nth-child(5n) {
        animation-delay: 3.4s;
      }
      @keyframes cellidle {
        0%,
        100% {
          background: var(--panel);
        }
        50% {
          background: var(--panel-2);
        }
      }
      .dcell.trail,
      .dcell.hot,
      .dcell.on {
        animation: none;
      }
      .dcell.trail {
        background: rgba(38, 153, 123, 0.14);
        border-color: rgba(38, 153, 123, 0.35);
      }
      .dcell.hot {
        background: rgba(31, 216, 164, 0.3);
        border-color: rgba(31, 216, 164, 0.7);
      }
      .dcell.on {
        background: rgba(31, 216, 164, 0.55);
        border-color: var(--green-bright);
        box-shadow: 0 0 14px -3px var(--green-glow);
        animation: land 0.45s ease-out;
      }
      @keyframes land {
        from {
          box-shadow:
            0 0 0 0 rgba(31, 216, 164, 0.45),
            0 0 14px -3px var(--green-glow);
        }
        to {
          box-shadow:
            0 0 0 9px rgba(31, 216, 164, 0),
            0 0 14px -3px var(--green-glow);
        }
      }
      .dfa-result {
        opacity: 0;
        transform: translateY(4px);
        transition:
          opacity 0.35s ease,
          transform 0.35s ease;
        margin-top: 0;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--green-bright);
        border: 1px solid rgba(38, 153, 123, 0.4);
        background: var(--green-dim);
        border-radius: 9px;
        padding: 8px 14px;
      }
      .dfa-result.show {
        opacity: 1;
        transform: none;
      }
      .dfa-result .sep {
        color: var(--faint);
      }
      .bench-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-top: 44px;
      }
      .bench {
        background: var(--surface);
        border: 1px solid var(--surface-border);
        box-shadow: var(--surface-shadow);
        border-radius: var(--radius);
        padding: 22px 24px;
      }
      .bench .num {
        font-family: var(--font-mono);
        font-size: 30px;
        font-weight: 600;
        color: var(--green-bright);
        line-height: 1.1;
        font-feature-settings: 'tnum';
      }
      .bench .label {
        color: var(--muted);
        font-size: 13.5px;
        margin-top: 6px;
      }
      .bench-note {
        color: var(--faint);
        font-size: 13px;
        margin: 18px 0 0;
      }

      /* ---------- Quickstart code window ---------- */
      .code-window {
        margin-top: 44px;
        max-width: 720px;
        border-radius: 12px;
        box-shadow:
          var(--card-shadow),
          0 0 60px -40px var(--green-glow);
      }

      /* ---------- Input controller ---------- */
      .io-grid {
        display: grid;
        grid-template-columns: 1fr 0.9fr;
        gap: 64px;
        align-items: start;
        margin-top: 44px;
      }
      .case-label {
        font-family: var(--font-mono);
        font-size: 11.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--green);
        margin: 0 0 16px;
      }
      .steps-list {
        margin: 0 0 18px;
        padding-left: 22px;
        color: var(--muted);
        font-size: 15.5px;
      }
      .steps-list li {
        margin: 0 0 10px;
      }
      .steps-list li::marker {
        color: var(--green);
        font-family: var(--font-mono);
        font-size: 13px;
      }
      .field-shell {
        background: var(--surface);
        border: 1px solid var(--surface-border);
        box-shadow: var(--surface-shadow);
        border-radius: 18px;
        padding: 28px;
      }
      .field-label {
        display: block;
        font-size: 13px;
        color: var(--muted);
        margin: 0 0 10px;
      }
      .field-readout {
        display: flex;
        align-items: baseline;
        gap: 14px;
        margin: 14px 2px 0;
      }
      .field-readout .k {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faint);
      }
      .field-readout code {
        font-family: var(--font-mono);
        font-size: 13.5px;
        color: var(--green-bright);
      }
      .field-readout code.empty {
        color: var(--faint);
      }

      .paths {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 56px;
      }
      .path {
        background: var(--surface);
        border: 1px solid var(--surface-border);
        box-shadow: var(--surface-shadow);
        border-radius: var(--radius);
        padding: 26px 26px 20px;
        transition: border-color 0.2s ease;
      }
      .path:hover {
        border-color: rgba(38, 153, 123, 0.35);
      }
      .path h3 {
        margin: 0 0 8px;
        font-size: 17px;
        font-weight: 650;
        letter-spacing: -0.015em;
      }
      .path p {
        color: var(--muted);
        font-size: 14.5px;
        margin: 0 0 18px;
      }
      .path p code {
        color: var(--green-bright);
        font-family: var(--font-mono);
        font-size: 0.88em;
      }
      .after-paths {
        margin: 24px 0 0;
        font-size: 14.5px;
        color: var(--muted);
      }

      /* ---------- Code blocks (Expressive Code) ---------- */
      code {
        font-family: var(--font-mono);
      }
      .expressive-code {
        margin: 0;
      }
      .expressive-code .expressive-code {
        margin: 0;
      }

      /* ---------- Developer experience: bento ---------- */
      .bento {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 16px;
        margin-top: 48px;
      }
      .cell {
        grid-column: span 2;
        background: var(--surface);
        border: 1px solid var(--surface-border);
        box-shadow: var(--surface-shadow);
        border-radius: var(--radius);
        padding: 24px;
        transition:
          border-color 0.2s ease,
          transform 0.2s ease;
      }
      .cell:hover {
        border-color: rgba(38, 153, 123, 0.35);
        transform: translateY(-3px);
      }
      .cell.wide {
        grid-column: span 3;
      }
      .cell h3 {
        margin: 0 0 7px;
        font-size: 15.5px;
        font-weight: 650;
        letter-spacing: -0.01em;
        display: flex;
        align-items: center;
        gap: 9px;
      }
      .cell h3 .tick {
        color: var(--green);
        font-family: var(--font-mono);
        font-weight: 600;
      }
      .cell p {
        margin: 0;
        color: var(--muted);
        font-size: 13.5px;
      }
      .cell .expressive-code {
        margin-top: 14px;
      }
      .cell .expressive-code pre {
        font-size: 12px;
      }

      /* ---------- Packages ---------- */
      .stack {
        margin-top: 48px;
        display: flex;
        flex-direction: column;
        gap: 0;
      }
      .slab {
        position: relative;
        display: grid;
        grid-template-columns: 230px 90px 1fr;
        gap: 10px 22px;
        align-items: baseline;
        background: var(--surface);
        border: 1px solid var(--surface-border);
        box-shadow: var(--surface-shadow);
        border-radius: var(--radius);
        padding: 22px 26px;
        transition:
          border-color 0.2s ease,
          transform 0.2s ease;
      }
      .slab + .slab {
        margin-top: 14px;
      }
      a.slab:hover {
        border-color: rgba(38, 153, 123, 0.4);
        transform: translateX(4px);
      }
      .slab .name {
        font-family: var(--font-mono);
        font-size: 14.5px;
        font-weight: 500;
      }
      .chip {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        border-radius: 999px;
        padding: 3px 10px;
        justify-self: start;
      }
      .chip-today {
        color: var(--green-bright);
        border: 1px solid rgba(38, 153, 123, 0.45);
        background: var(--green-dim);
      }
      .chip-planned {
        color: var(--faint);
        border: 1px solid var(--border-strong);
      }
      .slab .desc {
        color: var(--muted);
        font-size: 14.5px;
      }
      .stack-note {
        color: var(--muted);
        font-size: 15.5px;
        max-width: 660px;
        margin: 26px 0 0;
      }

      /* ---------- Get started ---------- */
      .start-grid {
        display: grid;
        grid-template-columns: 0.76fr 1.24fr;
        gap: 48px;
        align-items: center;
      }
      .start-rail .sec-head {
        margin-bottom: 30px;
      }

      .start-rail .install {
        margin: 0 0 20px;
      }
      /* Decorative prompt: generated content never reaches selection or the copy button payload. */
      .install .expressive-code .ec-line .code::before {
        content: '$';
        color: var(--green-bright);
        margin-right: 12px;
      }
      .install .expressive-code pre,
      .install .expressive-code .frame {
        box-shadow: none;
      }
      .start-rail .lead {
        margin: 0 0 30px;
        font-size: 16px;
        max-width: 420px;
      }
      .start-rail .cta-row {
        margin: 0;
      }
      .start-grid .code-window {
        margin-top: 0;
        max-width: none;
      }

      /* ---------- Footer ---------- */
      footer {
        border-top: 1px solid var(--border);
        padding: 44px 0;
      }
      footer .container {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        align-items: center;
        justify-content: space-between;
      }
      footer .meta {
        color: var(--faint);
        font-size: 13.5px;
      }
      footer .links {
        display: flex;
        gap: 22px;
        color: var(--muted);
        font-size: 13.5px;
      }
      footer .links a:hover {
        color: var(--text);
      }

      /* ---------- Reveal on scroll ---------- */
      .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition:
          opacity 0.65s ease,
          transform 0.65s ease;
      }
      .reveal.in {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .dcell {
          animation: none;
        }
      }

      /* Between 920 and 1120 the two-column code grids no longer fit their longest lines. */
      @media (max-width: 1120px) {
        .paths {
          grid-template-columns: 1fr;
        }
        .start-grid {
          grid-template-columns: 1fr;
          gap: 44px;
        }
      }

      @media (max-width: 920px) {
        .hero {
          padding-top: 132px;
        }
        .hero-grid,
        .verified-grid,
        .engine-grid,
        .io-grid {
          grid-template-columns: 1fr;
          gap: 44px;
        }
        .paths {
          grid-template-columns: 1fr;
        }
        .bench-strip {
          grid-template-columns: 1fr;
        }
        .start-grid {
          grid-template-columns: 1fr;
          gap: 40px;
        }
        .bento {
          grid-template-columns: 1fr 1fr;
        }
        .cell,
        .cell.wide {
          grid-column: span 1;
        }
        .slab {
          grid-template-columns: 1fr;
        }
        .nav-links {
          display: none;
        }
        .nav-cta {
          display: none;
        }
        section {
          padding: 76px 0;
        }
      }

      @media (max-width: 640px) {
        .bento {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="atmosphere"></div>

    <!-- NAV -->
    <header class="nav" id="nav">
      <div class="container">
        <a class="brand" href="/" aria-label="Telixon">
          <img class="brand-logo brand-logo-dark" src={logoDark.src} alt="Telixon" />
          <img class="brand-logo brand-logo-light" src={logoLight.src} alt="Telixon" />
        </a>
        <nav class="nav-links">
          <a href="#verified">Proof</a>
          <a href="#compiled-engine">Engine</a>
          <a href="#input-controller">Input</a>
          <a href="#packages">Packages</a>
        </nav>
        <div class="nav-right">
          <button class="nav-btn theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"
              ><circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path></svg
            >
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path></svg
            >
          </button>
          <a class="nav-btn" href="https://github.com/martsinlabs/telixon" aria-label="GitHub">
            <svg viewBox="0 0 16 16" aria-hidden="true"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path></svg
            >
            GitHub
          </a>
          <a class="nav-btn" href="/core/">Docs</a>
          <a class="nav-btn nav-cta" href="#get-started">Get started</a>
        </div>
      </div>
    </header>

    <!-- 1 · HERO (owns: the claim, install, the live product) -->
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <h1>Phone number <span class="hl">toolkit</span> for JavaScript and TypeScript.</h1>
          <p class="sub">Parsing, validation, formatting, and a headless input controller. Zero dependencies.</p>
          <p class="hero-proof">
            <a class="link-green" href="https://telixon.dev/parity.html" target="_blank" rel="noreferrer"
              >100% geographic parity, verified against Google libphonenumber</a
            >
            <a class="link-green" href="https://telixon.dev/benchmark.html" target="_blank" rel="noreferrer"
              >About 4x faster parsing, measured in CI</a
            >
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#get-started">
              Get started
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </div>
        </div>

        <div class="demo-card">
          <div class="demo-head">
            <span class="demo-title">Phone input</span>
            <span class="valid-pill" id="hero-valid">valid</span>
          </div>
          <div class="demo-input" id="hero-shell">
            <span class="flag" id="hero-flag">🌐</span>
            <input
              id="hero-input"
              type="text"
              inputmode="tel"
              autocomplete="off"
              spellcheck="false"
              readonly
              placeholder="+1 415-555-0132"
              aria-label="Try the phone input"
            />
          </div>
          <div class="demo-rows">
            <span class="k">Region</span><span class="v" id="hero-region"></span>
            <span class="k">Number type</span><span class="v" id="hero-type"></span>
            <span class="k">E.164</span><span class="v accent" id="hero-e164"></span>
            <span class="k">Error</span><span class="v" id="hero-error"><span class="err-kind" id="hero-error-kind"></span><span class="err-note" id="hero-error-note"></span></span>
          </div>
        </div>
      </div>
    </section>

    <div class="hairline"></div>

    <!-- 2 · GET STARTED (owns: the first-run code and the paths into the docs) -->
    <section id="get-started">
      <div class="container reveal">
        <div class="start-grid">
          <div class="start-rail">
            <div class="sec-head"><h2>Get started</h2></div>
            <div class="install"><Code lang="sh" code="npm install @telixon/core" frame="none" /></div>
            <p class="lead">
              One await at startup loads the <a class="link-green" href="#compiled-engine">engine</a> into memory.
              The rest of the API is synchronous.
            </p>
            <div class="cta-row">
              <a class="btn btn-primary" href="/core/">
                Open the docs
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </a>
            </div>
          </div>
          <div class="code-window expressive-code" data-theme="dark">
            <Code lang="ts" code={quickstartCode} title="quickstart.ts" />
          </div>
        </div>
      </div>
    </section>

    <div class="hairline"></div>

    <!-- 3 · VERIFIED AGAINST GOOGLE (owns: all accuracy and proof) -->
    <section id="verified">
      <div class="container reveal">
        <div class="sec-head"><h2>Verified against Google</h2></div>
        <div class="verified-grid">
          <div class="prose">
            <p>
              The conformance suite loads Google libphonenumber's own source at the exact commit the <a
                class="link-green"
                href="#compiled-engine">engine</a
              > was compiled from, so there is no version drift between the library and its reference.
            </p>
            <p>
              On every push to main and every pull request, <a
                class="link-green"
                href="https://github.com/martsinlabs/telixon/actions/workflows/ci.yml"
                target="_blank"
                rel="noreferrer">CI replays</a
              > the whole conformance corpus against Google's source, across every supported region, and fails the build on
              any divergence. Once a week, an <a
                class="link-green"
                href="https://github.com/martsinlabs/telixon/actions/workflows/fuzz.yml"
                target="_blank"
                rel="noreferrer">exhaustive enumeration</a
              > re-proves the result across every input the engine can distinguish, at every length. The input controllers
              go through the same gate: every input is typed character by character, and the controller's resolved number
              must equal the parser's.
            </p>
            <p>
              Explore the results on the <a
                class="link-green"
                href="https://telixon.dev/parity.html"
                target="_blank"
                rel="noreferrer">live dashboard</a
              >.
            </p>
          </div>
          <div class="proof-card">
            <div class="proof-big">1.8B+</div>
            <div class="proof-sub">inputs in the weekly exhaustive proof</div>
            <div class="proof-rows">
              <span class="k">Regions</span><span class="v">245</span>
              <span class="k">Methods compared</span><span class="v">12</span>
              <span class="k">Allowlisted divergences</span><span class="v">0</span>
            </div>
          </div>
        </div>
        <p class="footnote">
          Parity is measured over geographic regions. Non-geographic ranges (Google's region 001, for example +800) are
          out of scope.
        </p>
      </div>
    </section>

    <div class="hairline"></div>

    <!-- 4 · COMPILED ENGINE (owns: mechanism, size, loading, process model) -->
    <section id="compiled-engine">
      <div class="container reveal">
        <div class="sec-head"><h2>Compiled Engine</h2></div>
        <div class="engine-grid">
          <div class="prose">
            <p>
              Telixon compiles Google libphonenumber's <a
                class="link-green"
                href="https://github.com/google/libphonenumber/blob/2b407afb2e005e5c2b3056881ecca3830e2dc585/resources/PhoneNumberMetadata.xml"
                target="_blank"
                rel="noreferrer">metadata and rules</a
              > into a deterministic finite automaton (DFA), stored as compact binary tables. Most libraries interpret those
              rules at runtime, on every parse. Telixon does that work once, ahead of time.
            </p>
            <p>
              Parsing a number is a walk over the DFA, one digit per step. The state the walk ends on already holds the
              region, the number type, whether the number is valid, and how to format it.
            </p>
            <p>
              The engine is lazy by design. Its tables stay out of your initial bundle until you call <code
                >ensureEngineReady()</code
              >, which loads and decodes them off the main thread. You choose the moment; nothing loads at import time.
            </p>
          </div>
          <div class="dfa">
            <p class="dfa-label">One digit, one step</p>
            <div class="walk-digits" id="walk-digits"></div>
            <div class="dfa-grid" id="dfa-grid" aria-hidden="true"></div>
            <div class="dfa-result" id="walk-result">
              <span>US</span><span class="sep">·</span><span>Fixed line or mobile</span><span class="sep">·</span><span
                >Valid</span
              >
            </div>
          </div>
        </div>
        <div class="bench-strip">
          <div class="bench">
            <div class="num">119 KB</div>
            <div class="label">the whole world's numbering rules, compiled and compressed</div>
          </div>
          <div class="bench">
            <div class="num">&lt;1%</div>
            <div class="label">of one display frame per keystroke, at the 99th percentile, even at 360 Hz</div>
          </div>
          <div class="bench">
            <div class="num">Every PR</div>
            <div class="label">performance-gated, so a regression cannot merge quietly</div>
          </div>
        </div>
        <p class="bench-note">
          Measured by the benchmark suite in the repository. Full, dated runs on the <a
            class="link-green"
            href="https://telixon.dev/benchmark.html"
            target="_blank"
            rel="noreferrer">live benchmarks</a
          >.
        </p>
      </div>
    </section>

    <div class="hairline"></div>

    <!-- 5 · INPUT CONTROLLER (owns: editing behavior, the AR hard case) -->
    <section id="input-controller">
      <div class="container reveal">
        <div class="sec-head"><h2>Input Controller</h2></div>
        <p class="lead">
          A complete API for a phone-number field. It handles every action a real input has: insert, delete forward or
          backward, replace a selection, undo, redo. The caret and the format stay correct on every keystroke.
        </p>

        <div class="io-grid">
          <div class="prose">
            <p class="case-label">Hard case, Argentina mobile</p>
            <p>
              In Argentina, a mobile number carries two dialing prefixes that aren't part of the number itself: a
              leading <code>0</code> and a mobile <code>15</code>. So Telixon runs a full round-trip on every keystroke:
            </p>
            <ol class="steps-list">
              <li>
                Strips the <code>0</code> and the <code>15</code>, adds the mobile <code>9</code>, and gets the
                canonical national number.
              </li>
              <li>Determines the region, number type, and format.</li>
              <li>
                Drops the added <code>9</code>, restores the <code>0</code> and the <code>15</code>, and applies the
                resolved format.
              </li>
            </ol>
            <p>The caret survives the whole strip-and-restore round-trip.</p>
            <p>
              See <a
                class="link-green"
                href="https://en.wikipedia.org/wiki/Telephone_numbers_in_Argentina"
                target="_blank"
                rel="noreferrer">how Argentine mobile numbers are structured</a
              >.
            </p>
          </div>
          <div class="field-shell">
            <label class="field-label" for="ar-input">AR national mobile number</label>
            <div class="demo-input">
              <span class="flag">🇦🇷</span>
              <input
                id="ar-input"
                type="text"
                inputmode="tel"
                autocomplete="off"
                spellcheck="false"
                readonly
                value="011 15-2345-6789"
                aria-label="Argentine mobile number"
              />
            </div>
            <div class="field-readout"><span class="k">E.164</span><code id="ar-e164">+5491123456789</code></div>
          </div>
        </div>

        <div class="paths">
          <div class="path">
            <h3>Wire it yourself</h3>
            <p>Each editing method takes the current value and selection, and returns the next value and caret.</p>
            <div class="expressive-code" data-theme="dark"><Code lang="ts" code={coreControllerCode} /></div>
          </div>
          <div class="path">
            <h3>Or let web-sdk do it</h3>
            <p>
              <code>createPhoneInput</code> binds the controller to a real <code>&lt;input&gt;</code> and handles beforeinput,
              paste, drop, word delete, and IME.
            </p>
            <div class="expressive-code" data-theme="dark"><Code lang="ts" code={webSdkCode} /></div>
          </div>
        </div>
        <p class="after-paths">
