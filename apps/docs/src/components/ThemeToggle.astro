---
// Icon-only theme toggle, identical to the landing nav control: sun in dark, moon in light.
---

<button class="theme-toggle" type="button" aria-label="Toggle color theme">
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"
    ><circle cx="12" cy="12" r="4"></circle><path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path></svg
  >
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"
    ><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path></svg
  >
</button>

<script>
  // Flip the theme and persist under Starlight's key. Starlight renders this control in the
  // header and in the mobile menu footer, so wire every instance.
  document.querySelectorAll('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {
        // Storage unavailable; the flip still applies for this page view.
      }
    });
  });
</script>
