---
// Sidebar override: a compact package switcher on top, then only the active package's tree below.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { AVAILABLE_PACKAGES, PLANNED_PACKAGES, packageForPath, type DocsPackage } from '../package-registry';

// Official framework marks, inlined verbatim (geometry and colors untouched; ids namespaced).
const LOGOS: Record<NonNullable<DocsPackage['logo']>, string> = {
  angular: `<svg viewBox="0 0 200 211.7" fill="none" xmlns="http://www.w3.org/2000/svg"><g transform="scale(.90059)" clip-path="url(#tx-ng-clip)"><path d="m222.08 39.192-8.019 125.92-76.671-165.12zm-53.105 162.82-57.933 33.056-57.934-33.056 11.783-28.556h92.301zm-57.933-139.34 30.357 73.803h-60.715zm-103.1 102.44-7.937-125.92 84.69-39.192z" fill="url(#tx-ng-a)"/><path d="m222.08 39.192-8.019 125.92-76.671-165.12zm-53.105 162.82-57.933 33.056-57.934-33.056 11.783-28.556h92.301zm-57.933-139.34 30.357 73.803h-60.715zm-103.1 102.44-7.937-125.92 84.69-39.192z" fill="url(#tx-ng-b)"/></g><defs><linearGradient id="tx-ng-a" x1="49.009" x2="225.83" y1="213.75" y2="129.72" gradientUnits="userSpaceOnUse"><stop stop-color="#E40035" offset="0"/><stop stop-color="#F60A48" offset=".24"/><stop stop-color="#F20755" offset=".352"/><stop stop-color="#DC087D" offset=".494"/><stop stop-color="#9717E7" offset=".745"/><stop stop-color="#6C00F5" offset="1"/></linearGradient><linearGradient id="tx-ng-b" x1="41.025" x2="156.74" y1="28.344" y2="160.34" gradientUnits="userSpaceOnUse"><stop stop-color="#FF31D9" offset="0"/><stop stop-color="#FF5BE1" stop-opacity="0" offset="1"/></linearGradient><clipPath id="tx-ng-clip"><path d="m0 0h223v236h-223z" fill="#fff"/></clipPath></defs></svg>`,
  react: `<svg viewBox="-11.5 -10.23174 23 20.46348" xmlns="http://www.w3.org/2000/svg"><circle r="2.05" fill="#61dafb"/><g stroke="#61dafb" stroke-width="1" fill="none"><ellipse rx="11" ry="4.2"/><ellipse rx="11" ry="4.2" transform="rotate(60)"/><ellipse rx="11" ry="4.2" transform="rotate(120)"/></g></svg>`,
  vue: `<svg viewBox="0 0 261.76 226.69" xmlns="http://www.w3.org/2000/svg"><g transform="matrix(1.3333 0 0 -1.3333 -76.311 313.34)"><g transform="translate(178.06 235.01)"><path d="m0 0-22.669-39.264-22.669 39.264h-75.491l98.16-170.02 98.16 170.02z" fill="#41b883"/></g><g transform="translate(178.06 235.01)"><path d="m0 0-22.669-39.264-22.669 39.264h-36.227l58.896-102.01 58.896 102.01z" fill="#34495e"/></g></g></svg>`,
  stencil: `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#5530FF" d="M8.85 15.66h9.25l-5 5.34H3.9ZM24 9.328H4.997L0 14.672h19.003ZM10.884 3H20.1l-4.977 5.34H5.9Z"/></svg>`,
};

const active = packageForPath(Astro.url.pathname);

// The config defines one group per package, matched by npm name; a missing group means the
// registry and astro.config.mjs drifted apart, which must fail the build, not render silently.
const { sidebar } = Astro.locals.starlightRoute;
const activeGroup = sidebar.find((entry) => entry.type === 'group' && entry.label === active.name);
if (!activeGroup || activeGroup.type !== 'group') {
  throw new Error(`PackageSidebar: no sidebar group labeled "${active.name}" in astro.config.mjs`);
}
Astro.locals.starlightRoute.sidebar = activeGroup.entries;
---

<div class="pkg-switch">
  <details>
    <summary>
      <span class="pkg-icon pkg-icon-bare" aria-hidden="true"><img class="pkg-mark" src="/favicon.svg" alt="" /></span>
      <span class="pkg-name">{active.label}</span>
      <svg class="pkg-chevrons" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 6.25 8 3.5l3 2.75" />
        <path d="M5 9.75 8 12.5l3-2.75" />
      </svg>
    </summary>
    <nav class="pkg-menu" aria-label="Packages">
      {
        AVAILABLE_PACKAGES.map((pkg) => (
          <a href={`/${pkg.base}/`} aria-current={pkg.base === active.base ? 'true' : undefined}>
            <span class="pkg-icon pkg-icon-bare" aria-hidden="true">
              <img class="pkg-mark" src="/favicon.svg" alt="" />
            </span>
            <span class="pkg-name">{pkg.label}</span>
          </a>
        ))
      }
      {PLANNED_PACKAGES.length > 0 && <p class="pkg-section">Planned</p>}
      {
        PLANNED_PACKAGES.map((pkg) => (
          <span class="pkg-planned" aria-disabled="true">
            <span class="pkg-icon pkg-icon-bare" aria-hidden="true">
              {
                pkg.logo !== undefined ? (
                  <Fragment set:html={LOGOS[pkg.logo]} />
                ) : (
                  <img class="pkg-mark" src="/favicon.svg" alt="" />
                )
              }
            </span>
            <span class="pkg-name">{pkg.label}</span>
          </span>
        ))
      }
    </nav>
  </details>
</div>

<Default><slot /></Default>

<script>
  // Close the package menu when clicking anywhere outside it.
  document.querySelectorAll('.pkg-switch details').forEach((details) => {
    document.addEventListener('click', (event) => {
      if (details.hasAttribute('open') && event.target instanceof Node && !details.contains(event.target)) {
        details.removeAttribute('open');
      }
    });
  });
</script>
