{
  "name": "@telixon/example-web-components-kitchen-sink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --ssr src/react/entry-server.tsx && node scripts/prerender.mjs",
