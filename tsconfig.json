{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["node"],
    "rootDir": "./",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@telixon/core": ["./packages/core/src/index.node.ts"],
      "@telixon/core/*": ["./packages/core/src/*"],
      "@telixon/web-sdk": ["./packages/web-sdk/src/index.ts"],
      "@telixon/web-sdk/flags": ["./packages/web-sdk/src/flags/index.ts"],
      "@telixon/web-components": ["./packages/web-components/src/index.ts"]
    }
  }
}
