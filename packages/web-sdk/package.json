{
  "name": "@telixon/web-sdk",
  "version": "0.1.0",
  "description": "Headless DOM adapter for @telixon/core: PhoneInput and CountryList state machines for the web.",
  "keywords": [
    "phone-input",
    "phone-number",
    "country-picker",
    "phone-validation",
    "phone-formatter",
    "intl-phone",
    "headless"
  ],
  "homepage": "https://telixon.dev",
  "bugs": {
    "url": "https://github.com/martsinlabs/telixon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martsinlabs/telixon.git",
    "directory": "packages/web-sdk"
  },
  "license": "Apache-2.0",
  "author": "Myroslav Martsin <myroslav@martsinlabs.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@telixon/core": "workspace:*"
  },
  "devDependencies": {
    "@telixon/testing": "workspace:*"
  },
  "packageManager": "pnpm@10.16.1"
}
