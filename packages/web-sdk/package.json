{
  "name": "@telixon/web-sdk",
  "version": "1.2.0",
  "description": "DOM adapter for @telixon/core: PhoneInput driving a plain <input>, RegionList and RegionPicker behind region pickers, and a flag sprite for every region.",
  "keywords": [
    "phone-input",
    "phone-number",
    "phone-validation",
    "phone-formatter",
    "intl-phone",
    "headless"
  ],
  "homepage": "https://telixon.dev",
  "bugs": {
    "url": "https://github.com/martsinlabs/telixon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martsinlabs/telixon.git",
    "directory": "packages/web-sdk"
  },
  "license": "Apache-2.0",
  "author": "Myroslav Martsin <myroslav@martsinlabs.com>",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./flags": {
      "types": "./dist/flags/index.d.ts",
      "default": "./dist/flags/index.js"
    },
    "./flags/flags.css": "./dist/flags/flags.css",
    "./flags/sprite.png": "./dist/flags/sprite.png",
    "./flags/sprite@2x.png": "./dist/flags/sprite@2x.png"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && pnpm run copy:flags",
    "build:flags": "node scripts/build-flag-sprite.mjs",
    "copy:flags": "cpy \"src/flags/assets/*\" dist/flags",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@telixon/core": "workspace:*"
  },
  "peerDependencies": {
    "@telixon/core": "workspace:^"
  },
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
