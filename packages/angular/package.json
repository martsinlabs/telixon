{
  "name": "@telixon/angular",
  "version": "21.0.0",
  "description": "Phone fields for Angular, built on @telixon/web-sdk.",
  "keywords": [
    "angular",
    "phone-input",
    "phone-number",
    "phone-validation",
    "phone-formatter",
    "intl-phone"
  ],
  "homepage": "https://telixon.dev",
  "bugs": {
    "url": "https://github.com/martsinlabs/telixon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martsinlabs/telixon.git",
    "directory": "packages/angular"
  },
  "license": "Apache-2.0",
  "author": "Myroslav Martsin <myroslav@martsinlabs.com>",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./flags/flags.css": {
      "default": "./flags/flags.css"
    }
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json && node scripts/build-schematics.mjs",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.schematics.json"
  },
  "dependencies": {
    "@telixon/core": "workspace:^",
    "@telixon/web-sdk": "workspace:^",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.5",
    "@analogjs/vitest-angular": "2.7.5",
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@schematics/angular": "~22.2.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "~22.2.2",
    "rxjs": "^7.8.0",
    "typescript": "~6.0.0",
    "zone.js": "~0.16.3"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "ng-add": {
    "save": "dependencies"
  },
  "ng-update": {
    "migrations": "./schematics/migration.json",
    "packageGroup": [
      "@telixon/core",
      "@telixon/web-sdk",
      "@telixon/angular"
    ]
  },
  "schematics": "./schematics/collection.json"
}
