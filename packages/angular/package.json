{
  "name": "@telixon/angular",
  "version": "20.0.0",
  "description": "Angular binding for @telixon/web-sdk.",
  "keywords": [
    "angular",
    "phone-input",
    "phone-number",
    "phone-validation",
    "phone-formatter",
    "intl-phone"
  ],
  "homepage": "https://telixon.dev",
  "bugs": {
    "url": "https://github.com/martsinlabs/telixon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martsinlabs/telixon.git",
    "directory": "packages/angular"
  },
  "license": "Apache-2.0",
  "author": "Myroslav Martsin <myroslav@martsinlabs.com>",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json"
  },
  "dependencies": {
    "@telixon/core": "workspace:^",
    "@telixon/web-sdk": "workspace:^",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "~20.3.0",
    "rxjs": "^7.8.0",
    "typescript": "~5.9.0",
    "zone.js": "~0.16.3"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/core": "^20.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
