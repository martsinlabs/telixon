{
  "$schema": "http://json-schema.org/schema",
  "$id": "TelixonAngularNgAdd",
  "title": "@telixon/angular ng add",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "The application to set up.",
      "$default": {
        "$source": "projectName"
      }
    },
    "preloadEngine": {
      "type": "boolean",
      "description": "Whether provideTelixon starts the engine load right after the first render.",
      "default": true
    }
  }
}
