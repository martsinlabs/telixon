{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "paths": {
      "@telixon/core": ["../core/src/index.browser.ts"],
      "@telixon/core/*": ["../core/src/*"],
      "@telixon/web-sdk": ["../web-sdk/src/index.ts"]
    }
  },
  "include": ["src"]
}
