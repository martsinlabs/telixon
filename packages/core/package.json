{
  "name": "@telixon/core",
  "version": "1.0.0",
  "description": "Phone number parser, formatter, and validator built on Google libphonenumber metadata.",
  "keywords": [
    "phone",
    "phone-number",
    "phone-validation",
    "phone-formatter",
    "phone-parser",
    "libphonenumber",
    "international",
    "e164"
  ],
  "homepage": "https://telixon.dev",
  "bugs": {
    "url": "https://github.com/martsinlabs/telixon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martsinlabs/telixon.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Myroslav Martsin <myroslav@martsinlabs.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./index.node.js",
      "browser": "./index.browser.js",
      "default": "./index.node.js"
    }
  },
  "main": "index.js",
  "scripts": {
    "build": "tsup && pnpm run copy:engine",
    "copy:engine": "cpy \"src/engine/**/*\" dist/engine",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/google-libphonenumber": "^7.4.30",
    "google-closure-library": "^20230802.0.0",
    "google-libphonenumber": "^3.2.44",
    "libphonenumber-js": "^1.13.3"
  },
  "packageManager": "pnpm@10.16.1"
}
