{
  "name": "@telixon/core",
  "version": "0.1.0",
  "description": "Phone number parser, formatter, and validator built on Google libphonenumber metadata.",
  "keywords": [
    "phone",
    "phone-number",
    "phone-validation",
    "phone-formatter",
    "phone-parser",
    "libphonenumber",
    "international",
    "e164"
  ],
  "homepage": "https://telixon.dev",
  "bugs": {
    "url": "https://github.com/martsinlabs/telixon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martsinlabs/telixon.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Myroslav Martsin <myroslav@martsinlabs.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.node.d.ts",
      "node": "./dist/index.node.js",
      "browser": "./dist/index.browser.js",
      "default": "./dist/index.node.js"
    }
  },
  "main": "./dist/index.node.js",
  "types": "./dist/index.node.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && pnpm run copy:engine",
    "copy:engine": "cpy \"src/engine/**/*\" \"!**/.DS_Store\" \"!src/engine/index.js\" \"!src/engine/index.d.ts\" dist/engine",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@telixon/testing": "workspace:*",
    "@types/google-libphonenumber": "^7.4.30",
    "google-closure-library": "^20230802.0.0",
    "google-libphonenumber": "^3.2.44",
    "libphonenumber-js": "^1.13.3"
  },
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
